{
  "schemaVersion": 1,
  "graphVersion": "1.0.0",
  "edgeSemantics": {
    "required": "Used to determine the ready-to-learn frontier.",
    "recommended": "Used for remediation and ranking but does not lock the target skill."
  },
  "prerequisites": {
    "measurement.unit_conversion": {"required": ["measurement.units_dimensions"], "recommended": ["math.arithmetic"]},
    "measurement.scientific_notation": {"recommended": ["math.arithmetic"]},
    "measurement.order_of_magnitude": {"required": ["measurement.scientific_notation"]},
    "measurement.dimensional_analysis": {"required": ["measurement.units_dimensions"], "recommended": ["math.algebra"]},
    "measurement.significant_figures": {"required": ["measurement.scientific_notation"]},
    "measurement.accuracy_precision": {"required": ["measurement.units_dimensions"]},
    "measurement.uncertainty": {"required": ["measurement.accuracy_precision", "measurement.significant_figures"]},
    "measurement.estimation": {"required": ["measurement.order_of_magnitude", "measurement.unit_conversion"]},
    "measurement.problem_modeling": {"required": ["measurement.units_dimensions"], "recommended": ["math.algebra"]},

    "vectors.coordinate_systems": {"required": ["vectors.scalar_vs_vector"]},
    "vectors.magnitude_direction": {"required": ["vectors.coordinate_systems"], "recommended": ["math.geometry", "math.trigonometry"]},
    "vectors.graphical_addition": {"required": ["vectors.magnitude_direction"]},
    "vectors.components": {"required": ["vectors.magnitude_direction"], "recommended": ["math.trigonometry"]},
    "vectors.components_to_vector": {"required": ["vectors.components"]},
    "vectors.unit_vectors": {"required": ["vectors.components"]},
    "vectors.analytical_addition": {"required": ["vectors.components", "vectors.graphical_addition"]},
    "vectors.subtraction": {"required": ["vectors.analytical_addition"]},
    "vectors.dot_product": {"required": ["vectors.components"], "recommended": ["math.trigonometry"]},
    "vectors.cross_product": {"required": ["vectors.components"], "recommended": ["math.trigonometry"]},

    "kinematics.distance": {"required": ["kinematics.position"]},
    "kinematics.displacement": {"required": ["kinematics.position", "kinematics.coordinate_signs"]},
    "kinematics.distance_vs_displacement": {"required": ["kinematics.distance", "kinematics.displacement"]},
    "kinematics.average_speed": {"required": ["kinematics.distance", "kinematics.elapsed_time"]},
    "kinematics.average_velocity": {"required": ["kinematics.displacement", "kinematics.elapsed_time"]},
    "kinematics.speed_vs_velocity": {"required": ["kinematics.average_speed", "kinematics.average_velocity", "vectors.scalar_vs_vector"]},
    "kinematics.instantaneous_velocity": {"required": ["kinematics.average_velocity"], "recommended": ["math.calculus.derivative"]},
    "kinematics.acceleration": {"required": ["kinematics.average_velocity", "kinematics.elapsed_time"]},
    "kinematics.acceleration_direction": {"required": ["kinematics.acceleration", "kinematics.coordinate_signs"]},
    "kinematics.velocity_vs_acceleration": {"required": ["kinematics.instantaneous_velocity", "kinematics.acceleration"]},
    "kinematics.constant_velocity": {"required": ["kinematics.average_velocity"]},
    "kinematics.constant_acceleration": {"required": ["kinematics.acceleration"], "recommended": ["math.algebra"]},
    "kinematics.equation_selection": {"required": ["kinematics.constant_acceleration"]},
    "kinematics.multistep_1d": {"required": ["kinematics.equation_selection", "kinematics.word_problem_modeling"]},
    "kinematics.free_fall": {"required": ["kinematics.constant_acceleration", "kinematics.coordinate_signs"]},
    "kinematics.vertical_motion": {"required": ["kinematics.free_fall"]},
    "kinematics.motion_from_acceleration": {"required": ["kinematics.acceleration"], "recommended": ["math.calculus.integral"]},

    "graphs.position_time": {"required": ["kinematics.position", "kinematics.elapsed_time"]},
    "graphs.velocity_from_position_slope": {"required": ["graphs.position_time", "kinematics.average_velocity"]},
    "graphs.velocity_time": {"required": ["kinematics.instantaneous_velocity", "kinematics.elapsed_time"]},
    "graphs.acceleration_from_velocity_slope": {"required": ["graphs.velocity_time", "kinematics.acceleration"]},
    "graphs.displacement_from_velocity_area": {"required": ["graphs.velocity_time", "kinematics.displacement"], "recommended": ["math.calculus.integral"]},
    "graphs.acceleration_time": {"required": ["kinematics.acceleration"]},
    "graphs.translate_representations": {"required": ["graphs.position_time", "graphs.velocity_time", "graphs.acceleration_time"]},

    "kinematics.displacement_vectors": {"required": ["kinematics.displacement", "vectors.components"]},
    "kinematics.velocity_vectors": {"required": ["kinematics.average_velocity", "vectors.components"]},
    "kinematics.acceleration_vectors": {"required": ["kinematics.acceleration", "vectors.components"]},
    "kinematics.independent_xy_motion": {"required": ["kinematics.constant_acceleration", "kinematics.velocity_vectors", "kinematics.acceleration_vectors"]},

    "projectile.concept": {"required": ["kinematics.independent_xy_motion", "kinematics.free_fall"]},
    "projectile.horizontal_launch": {"required": ["projectile.concept", "kinematics.constant_velocity"]},
    "projectile.angled_launch": {"required": ["projectile.concept", "vectors.components"]},
    "projectile.time_of_flight": {"required": ["projectile.angled_launch", "kinematics.vertical_motion"]},
    "projectile.maximum_height": {"required": ["projectile.angled_launch", "kinematics.vertical_motion"]},
    "projectile.range": {"required": ["projectile.time_of_flight", "kinematics.constant_velocity"]},
    "projectile.trajectory": {"required": ["projectile.angled_launch"], "recommended": ["math.algebra"]},
    "projectile.multistep": {"required": ["projectile.time_of_flight", "projectile.trajectory"], "recommended": ["projectile.maximum_height", "projectile.range"]},

    "circular.angular_motion": {"required": ["measurement.unit_conversion"], "recommended": ["math.geometry"]},
    "circular.centripetal_acceleration": {"required": ["kinematics.acceleration", "vectors.magnitude_direction"], "recommended": ["math.algebra"]},
    "circular.tangential_acceleration": {"required": ["kinematics.acceleration", "circular.angular_motion"]},
    "circular.total_acceleration": {"required": ["circular.centripetal_acceleration", "circular.tangential_acceleration", "vectors.components_to_vector"]},
    "circular.uniform_motion_vectors": {"required": ["circular.centripetal_acceleration", "vectors.components"], "recommended": ["math.trigonometry"]},

    "relative_motion.relative_velocity_1d": {"required": ["kinematics.average_velocity", "vectors.analytical_addition"]},
    "relative_motion.relative_velocity_2d": {"required": ["relative_motion.relative_velocity_1d", "vectors.components"]},
    "relative_motion.galilean_transform": {"required": ["relative_motion.relative_velocity_2d", "kinematics.displacement_vectors"]},
    "relative_motion.navigation": {"required": ["relative_motion.relative_velocity_2d"], "recommended": ["math.trigonometry"]}
  }
}
